# ---- Server ----
PORT=4000
CORS_ORIGIN=*

# ---- Database ----
# Leave MONGODB_URI blank to use the built-in JSON file store (data/db.json).
# For MongoDB Atlas, paste your connection string here:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/zsb?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Seed admin (created on first boot only) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
